POSTGRES_PASSWORD=
REDIS_PASSWORD=
GARAGE_RPC_SECRET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
S3_REGION=garage
S3_ROOT_USER=
S3_ROOT_PASSWORD=
TURN_SECRET=
TURN_REALM=
FLOWDROP_STUN_URL=
FLOWDROP_TURN_URL=
FLOWDROP_TRUSTED_PROXIES=
FLOWDROP_PUBLIC_ORIGIN=
FLOWDROP_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Optional public HTTPS edge: compose.yaml + compose.online.yaml (requires approval/DNS).
FLOWDROP_DOMAIN=
# JSON arrays support UDP/TCP/TLS URLs. Leave empty to use legacy single URL fields.
FLOWDROP_STUN_URLS=
FLOWDROP_TURN_URLS=
FLOWDROP_ICE_POLICY=all
# Desktop online handoff; alternatively configure these in the authenticated Online tab.
FLOWDROP_ONLINE_URL=
FLOWDROP_SIGNAL_URL=
# Required for a NATed/containerized Internet TURN relay: real public[/private] IPv4.
TURN_EXTERNAL_IP=
# Optional TURN-over-TLS cert/key paths mounted inside the TURN container.
TURN_TLS_CERT=
TURN_TLS_KEY=
